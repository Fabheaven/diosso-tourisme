{% extends 'base.html.twig' %}

{% block title %}Création de Newsletter{% endblock %}

{% block body %}
    <h1>Écrivez votre newsletter</h1>
    
    {{ form_start(form) }}
        {{ form_row(form.name) }}
        {# Champ de contenu visible comme un textarea classique #}
        {{ form_row(form.content, {
            'attr': {
                'placeholder': 'Rédigez le contenu de votre newsletter ici...',
                'rows': '10',
                'cols': '80',
                'style': 'width: 100%; padding: 10px; border: 1px solid #ccc;'
            }
        }) }}
        
        {{ form_row(form.categories) }}
        {{ form_row(form.submit) }}
    {{ form_end(form) }}
{% endblock %}

{% block javascripts %}
    <script>
        // Ajout d'un script si nécessaire pour styliser ou améliorer l'expérience utilisateur
        document.addEventListener('DOMContentLoaded', () => {
            console.log('La page du formulaire de newsletter est chargée.');
        });
    </script>
{% endblock %}
